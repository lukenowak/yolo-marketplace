{
  "arena_url": "https://git.example.com/<org>/arena.git",
  "arena_token_key": "<token key in ~/.claude/repo_tokens.json>",
  "originals": {
    "<repo>": {
      "url": "https://git.example.com/<org>/<repo>.git",
      "token_key": "<token key in ~/.claude/repo_tokens.json>"
    }
  },
  "timezone": "<IANA zone, e.g. Area/City>",
  "clone_dir": "<home>/tmp/{repo}",
  "docs_space": {
    "kind": "<e.g. silverbullet, google-docs>",
    "url": "https://docs.example.com/<space>/",
    "token_key": "<token key in ~/.claude/repo_tokens.json>"
  }
}
